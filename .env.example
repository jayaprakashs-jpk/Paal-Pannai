# Copy to .env for local dev. For EAS builds, set these with:
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value https://xxxx.supabase.co --environment preview --visibility plaintext
# The anon key is safe to ship (RLS protects data). NEVER put the service_role key or any AI key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: map tiles. Default is the public OpenStreetMap server (light use only). Example for a provider with a key:
# EXPO_PUBLIC_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
EXPO_PUBLIC_TILE_URL=
